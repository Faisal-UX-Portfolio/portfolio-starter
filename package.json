{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "check:security": "node scripts/check-security.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cv": "node scripts/generate-cv.mjs",
    "og": "node scripts/generate-images.mjs og",
    "onepagers": "node scripts/generate-onepagers.mjs",
    "banner": "node scripts/generate-images.mjs banner",
    "images": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^15.5.19",
    "@next/third-parties": "^16.2.9",
    "@opennextjs/cloudflare": "^1.20.1",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-unwrap-images": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.23",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  }
}
