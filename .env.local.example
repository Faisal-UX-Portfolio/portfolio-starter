# Copy this file to .env.local and fill it in. .env.local is gitignored and
# must never be committed. The setup-portfolio skill creates it for you.

# The passphrase for protected case studies and the site-wide lockdown.
# Four words of exactly four letters, joined with hyphens, e.g. mint-oval-kite-drum.
# The unlock screen is built for that shape: anything else cannot be typed into it.
PORTFOLIO_PASSWORD=

# Signs the access cookie. At least 32 random characters, and never the same
# as the passphrase. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# For the live site, set it as a build variable in Cloudflare instead (see
# GO-LIVE.md). Set it here only to test analytics against localhost.
NEXT_PUBLIC_GA_ID=

# Optional: phone number printed on the CV PDF. It only ever reaches the PDF
# generated on your machine; the deployed site never serves it.
CV_PHONE=

# Optional: Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
